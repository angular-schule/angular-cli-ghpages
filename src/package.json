{
  "name": "angular-cli-ghpages",
  "version": "3.1.2",
  "description": "Deploy your Angular app to GitHub Pages or Cloudflare Pages directly from the Angular CLI (ng deploy)",
  "main": "index.js",
  "types": "index.d.ts",
  "engines": {
    "node": ">=18.19.1",
    "npm": ">=9.0.0"
  },
  "bin": {
    "angular-cli-ghpages": "angular-cli-ghpages",
    "ngh": "angular-cli-ghpages"
  },
  "scripts": {
    "prebuild": "node scripts/prebuild.js",
    "build": "tsc -p tsconfig.build.json",
    "postbuild": "node scripts/postbuild.js",
    "test": "vitest run"
  },
  "schematics": "./collection.json",
  "builders": "./builders.json",
  "ng-add": {
    "save": "devDependencies"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/angular-schule/angular-cli-ghpages.git"
  },
  "keywords": [
    "angular",
    "cli",
    "angular-cli",
    "ghpages",
    "github",
    "github pages",
    "cloudflare pages",
    "pages",
    "deploy",
    "ng deploy",
    "ng-deploy",
    "gh-pages",
    "ghpages",
    "angular-cli-ghpages",
    "angular-cli-github-pages"
  ],
  "author": {
    "name": "Angular.Schule (by Johannes Hoppe)",
    "email": "johannes.hoppe@haushoppe-its.de"
  },
  "contributors": [
    "Minko Gechev <mgechev@gmail.com>",
    "Ferdinand Malcher <ferdinand@malcher.media>",
    "Danny Koppenhagen <mail@k9n.dev>"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/angular-schule/angular-cli-ghpages/issues"
  },
  "homepage": "https://github.com/angular-schule/angular-cli-ghpages/#readme",
  "devDependencies": {
    "@angular-devkit/architect": "~0.2202.2",
    "@angular-devkit/core": "~22.2.2",
    "@angular-devkit/schematics": "~22.2.2",
    "@types/node": "^26.6.4",
    "json-schema-to-typescript": "^16.0.0",
    "typescript": "~7.0.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@angular-devkit/architect": ">=0.1800.0 <0.2300.0",
    "@angular-devkit/core": ">=18.0.0 <23.0.0",
    "@angular-devkit/schematics": ">=18.0.0 <23.0.0",
    "gh-pages": "6.3.0"
  },
  "peerDependencies": {
    "@angular/cli": ">=18.0.0 <23.0.0"
  }
}
